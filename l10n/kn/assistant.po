msgid "The handler for %1 was not found. Please ensure the handler exists in api_handlers directory."
msgstr "%1 ಗಾಗಿ ಹ್ಯಾಂಡ್ಲರ್ ಕಂಡುಬಂದಿಲ್ಲ. ದಯವಿಟ್ಟು api_handlers ಡೈರೆಕ್ಟರಿಯಲ್ಲಿ ಹ್ಯಾಂಡ್ಲರ್ ಇದೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ."

msgid "The notebook is your conversation log: AI answers and quick notes are appended to it. You can create multiple notebooks to organize your logs."
msgstr "ನೋಟ್ಬುಕ್ ನಿಮ್ಮ ಸಂವಾದ ದಾಖಲೆಯಾಗಿದೆ: AI ಉತ್ತರಗಳು ಮತ್ತು ತ್ವರಿತ ಟಿಪ್ಪಣಿಗಳನ್ನು ಅದಕ್ಕೆ ಸೇರಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ದಾಖಲೆಗಳನ್ನು ಸಂಘಟಿಸಲು ನೀವು ಅನೇಕ ನೋಟ್ಬುಕ್ಗಳನ್ನು ರಚಿಸಬಹುದು."

msgid "This button creates a quick note with highlighted text."
msgstr "ಈ ಗುಂಡಿಯು ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯದೊಂದಿಗೆ ತ್ವರಿತ ಟಿಪ್ಪಣಿಯನ್ನು ರಚಿಸುತ್ತದೆ."

msgid "This is a custom prompt"
msgstr "ಇದು ಕಸ್ಟಮ್ ಪ್ರಾಂಪ್ಟ್ ಆಗಿದೆ"

msgid "This prompt acts as a dictionary for the highlighted text, to a word or phrase."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯಕ್ಕೆ, ಅಂದರೆ ಒಂದು ಪದ ಅಥವಾ ಪದಗುಚ್ಛಕ್ಕೆ, ನಿಘಂಟಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ."

msgid "This prompt analyzes the grammar of the highlighted text, providing a detailed explanation of its structure and any grammatical errors."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯದ ವ್ಯಾಕರಣವನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ, ಅದರ ರಚನೆ ಮತ್ತು ಯಾವುದೇ ವ್ಯಾಕರಣ ದೋಷಗಳ ವಿವರವಾದ ವಿವರಣೆಯನ್ನು ಒದಗಿಸುತ್ತದೆ."

msgid "This prompt analyzes the vocabulary of the highlighted text, identifying complex words and providing definitions, synonyms, and usage examples."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯದ ಶಬ್ದಕೋಶವನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ, ಸಂಕೀರ್ಣ ಪದಗಳನ್ನು ಗುರುತಿಸಿ ವ್ಯಾಖ್ಯಾನಗಳು, ಸಮಾನಾರ್ಥಕ ಪದಗಳು ಮತ್ತು ಬಳಕೆಯ ಉದಾಹರಣೆಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ."

msgid "This prompt creates a structured system for generating context-aware definitions of words or phrases from literature by analyzing the highlighted term within its surrounding text to provide nuanced explanations that capture both literal meaning and contextual significance."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಸಾಹಿತ್ಯದಿಂದ ಪದಗಳು ಅಥವಾ ಪದಗುಚ್ಛಗಳ ಸಂದರ್ಭ-ಅರಿವಿನ ವ್ಯಾಖ್ಯಾನಗಳನ್ನು ರಚಿಸಲು ಒಂದು ರಚನಾತ್ಮಕ ವ್ಯವಸ್ಥೆಯನ್ನು ಸೃಷ್ಟಿಸುತ್ತದೆ, ಹೈಲೈಟ್ ಮಾಡಿದ ಪದವನ್ನು ಅದರ ಸುತ್ತಲಿನ ಪಠ್ಯದೊಳಗೆ ವಿಶ್ಲೇಷಿಸಿ ಅಕ್ಷರಶಃ ಅರ್ಥ ಮತ್ತು ಸಂದರ್ಭೋಚಿತ ಮಹತ್ವ ಎರಡನ್ನೂ ಸೆರೆಹಿಡಿಯುವ ಸೂಕ್ಷ್ಮ ವಿವರಣೆಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ."

msgid "This prompt explains the highlighted text as if to a five-year-old, simplifying complex concepts into easily understandable terms."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯವನ್ನು ಐದು ವರ್ಷದ ಮಗುವಿಗೆ ವಿವರಿಸುವಂತೆ ವಿವರಿಸುತ್ತದೆ, ಸಂಕೀರ್ಣ ಪರಿಕಲ್ಪನೆಗಳನ್ನು ಸುಲಭವಾಗಿ ಅರ್ಥವಾಗುವ ಪದಗಳಲ್ಲಿ ಸರಳಗೊಳಿಸುತ್ತದೆ."

msgid "This prompt explains the highlighted text in detail, ensuring clarity and understanding."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯವನ್ನು ವಿವರವಾಗಿ ವಿವರಿಸುತ್ತದೆ, ಸ್ಪಷ್ಟತೆ ಮತ್ತು ಅರ್ಥವನ್ನು ಖಚಿತಪಡಿಸುತ್ತದೆ."

msgid "This prompt extracts and lists the key points from the highlighted text, ensuring clarity and organization."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯದಿಂದ ಪ್ರಮುಖ ಅಂಶಗಳನ್ನು ಹೊರತೆಗೆದು ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ, ಸ್ಪಷ್ಟತೆ ಮತ್ತು ಸಂಘಟನೆಯನ್ನು ಖಚಿತಪಡಿಸುತ್ತದೆ."

msgid "This prompt generates a comprehensive Wikipedia-style article based on the highlighted text, ensuring factual accuracy and neutrality."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯದ ಆಧಾರದ ಮೇಲೆ ಸಮಗ್ರ ವಿಕಿಪೀಡಿಯ-ಶೈಲಿಯ ಲೇಖನವನ್ನು ರಚಿಸುತ್ತದೆ, ಸತ್ಯಾಂಶದ ನಿಖರತೆ ಮತ್ತು ತಟಸ್ಥತೆಯನ್ನು ಖಚಿತಪಡಿಸುತ್ತದೆ."

msgid "This prompt provides a detailed historical context for the highlighted text, explaining its significance and background."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯಕ್ಕೆ ವಿವರವಾದ ಐತಿಹಾಸಿಕ ಸಂದರ್ಭವನ್ನು ಒದಗಿಸುತ್ತದೆ, ಅದರ ಮಹತ್ವ ಮತ್ತು ಹಿನ್ನೆಲೆಯನ್ನು ವಿವರಿಸುತ್ತದೆ."

msgid "This prompt simplifies the highlighted text to make it easier to understand."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯವನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸುಲಭವಾಗುವಂತೆ ಸರಳಗೊಳಿಸುತ್ತದೆ."

msgid "This prompt summarizes the highlighted text, capturing its main points and essential details."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯವನ್ನು ಸಾರಾಂಶಗೊಳಿಸುತ್ತದೆ, ಅದರ ಮುಖ್ಯ ಅಂಶಗಳು ಮತ್ತು ಅಗತ್ಯ ವಿವರಗಳನ್ನು ಸೆರೆಹಿಡಿಯುತ್ತದೆ."

msgid "This prompt translates the highlighted text to another language."
msgstr "ಈ ಪ್ರಾಂಪ್ಟ್ ಹೈಲೈಟ್ ಮಾಡಿದ ಪಠ್ಯವನ್ನು ಮತ್ತೊಂದು ಭಾಷೆಗೆ ಅನುವಾದಿಸುತ್ತದೆ."

