root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.lua]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

; Vendored third-party code — keep upstream formatting as-is
[{lib,l10n}/**]
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
